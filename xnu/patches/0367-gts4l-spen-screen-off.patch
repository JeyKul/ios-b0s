+/*
+ * gts4lpen=2 (Galaxy Tab S4's S Pen): one stylus event with pressure and tilt, x and y as touch() takes them. Whether
+ * UIKit on the iPhone X build makes a pencil UITouch of it is what this tests; gts4lpen=1 uses touch() as a finger.
+ */
+void
+SweetHIDTouch::pen(bool down, int x, int y, int pressure, int tilt_x, int tilt_y)
+{
+	static bool was;
+	int lx = x + fOffX, ly = y + fOffY;
+	lx = lx < 0 ? 0 : (lx > fLogicalW - 1 ? fLogicalW - 1 : lx);
+	ly = ly < 0 ? 0 : (ly > fLogicalH - 1 ? fLogicalH - 1 : ly);
+	IOFixed nx = (IOFixed)(((int64_t)lx << 16) / fLogicalW), ny = (IOFixed)(((int64_t)ly << 16) / fLogicalH);
+	IOHIDEvent *e = IOHIDEvent::digitizerEvent(mach_absolute_time(), 1, kIOHIDDigitizerTransducerTypeStylus, down, down ? 1 : 0, nx, ny);
+	if (e == NULL) {
+		return;
+	}
+	UInt32 mask = kIOHIDDigitizerEventPosition;
+	if (was != down) {
+		mask |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+	}
+	e->setIntegerValue(kIOHIDEventFieldDigitizerTouch, down);
+	e->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+	e->setFixedValue(kIOHIDEventFieldDigitizerPressure, down ? (IOFixed)(((int64_t)pressure << 16) / 4095) : 0);
+	e->setFixedValue(kIOHIDEventFieldDigitizerTiltX, (IOFixed)(tilt_x << 16));
+	e->setFixedValue(kIOHIDEventFieldDigitizerTiltY, (IOFixed)(tilt_y << 16));
+	was = down;
+	dispatchEvent(e);
+	e->release();
+}
