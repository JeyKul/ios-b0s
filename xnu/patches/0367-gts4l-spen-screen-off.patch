 	tt_wait(delay_s * 1000u);
 	tt.ahb_vote = 1u << 15;
+	tt.addr = 0x49u;
 	tt.vote = ml_io_map(TT_GCC_VOTE_PA, 0x1000);
 	tt.ahb = ml_io_map(0x00125000u, 0x1000);
