+sweet_hid_pen(int down, int x, int y, int pressure, int tilt_x, int tilt_y)
+{
+	if (gSweetTouch) {
+		gSweetTouch->pen(down != 0, x, y, pressure, tilt_x, tilt_y);
+	}
