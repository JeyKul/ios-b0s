 	int e = acpm_send(ACPM_CH_DVFS, DVFS_ID_G3D, G3D_RATE_KHZ, 0 /* FREQ_REQ */, 0, rep);
 	printf("B0S GPU: DVFS reply %d: %08x %08x %08x %08x; PLL_G3D 0x%x 0x%x\n", e, rep[0], rep[1], rep[2], rep[3],
