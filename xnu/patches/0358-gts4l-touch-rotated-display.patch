+/*
+ * Galaxy Tab S4 (gts4llte): ST FTS1BA90A ("stm,fts_touch") at I2C 0x49 on BLSP2 QUP2 (0xc1b6000), from
+ * its live DT and Samsung's drivers/input/touchscreen/stm_fts1ba90a. Boot-arg gts4ltouch=1 logs the raw
+ * events, =2 also sends them to iOS. Never writes the chip's flash: no firmware update, no calibration.
+ *   rails   L28 3.3 V (tsp_avdd) then L6 1.8 V (tsp_io); no reset, I2C switch or charger pins in the DT
+ *   clocks  BLSP2 AHB vote bit 15 (status 0x125004), QUP2 I2C CBCR 0x128008, RCGR 0x128020/24
+ *   pins    SDA 6 / SCL 7 function 3 (WEST), attention 121 (EAST), no pulls, 2 mA
+ *   FTS     system reset FA 20 00 00 24 81, read one event 0x60, 8-byte events: e[0] bits 1:0 type
+ *           (0 coordinates, 1 status), coordinates tid 5:2, action 7:6 (1 press, 2 move, 3 release)
+ * Touch reports 0..1599 x 0..2559; the rotated canvas sits in the middle of that (gts4lrot,
+ * SweetFramebuffer.cpp). sweet_hid_touch takes the Pixel's panel pixels, so add its 157,222 borders.
+ * gts4lflip bit 0 / bit 1: mirror touch x / y when the canvas is the other way up.
+ */
+#define GT_READ_ONE     0x60u
+#define GT_TOUCHTYPES   (0x01u | 0x20u | 0x40u)     /* touch, palm, wet: Samsung's default */
+static int gt_mode, gt_flip;
+
+static bool
+gt_wait_ready(void)
+{
+	static const uint8_t c = GT_READ_ONE;
+	uint8_t e[8] = {0};
+	unsigned errs = 0;
+	for (unsigned tries = 0; tries < 25;) {
+		int err = qup_xfer(&c, 1, e, 8);
+		if (err == 0 && (e[0] & 3u) == 1u && ((e[0] >> 2) & 0xfu) == 2u && e[1] == 0) {
+			return true;
+		}
+		if (err == 0 && e[0] == 0xf3 && errs++ < 32) {
+			printf("GTS4L TOUCH: error event %02x %02x %02x %02x\n", e[1], e[2], e[3], e[4]);
+			continue;
+		}
+		if (err) {
+			printf("GTS4L TOUCH: ready read err %d status %#x flags %#x\n", err, tt.last_status, tt.last_err);
+		}
+		tries++;
+		tt_wait(20);
+	}
+	printf("GTS4L TOUCH: not ready (last event %02x %02x %02x %02x)\n", e[0], e[1], e[2], e[3]);
+	return false;
+}
+
+static bool
+gt_init(void)
+{
+	static const uint8_t reset[6] = {0xfa, 0x20, 0x00, 0x00, 0x24, 0x81};
+	int err = EIO;
+	for (unsigned i = 0; i < 5 && (err = ftm_write(reset, 6)); i++) {
+		tt_wait(10);
+	}
+	if (err) {
+		printf("GTS4L TOUCH: reset err %d (%s) status %#x flags %#x\n", err,
+		    err == ENXIO ? "NACK: rails or address" : "bus", tt.last_status, tt.last_err);
+		return false;
+	}
+	tt_wait(10);
+	if (!gt_wait_ready()) {
+		return false;
+	}
+	static const uint8_t cid = 0x22;
+	uint8_t id[5] = {0};
+	err = qup_xfer(&cid, 1, id, 5);
+	printf("GTS4L TOUCH: chip id err %d: %02x %02x %02x %02x %02x\n", err, id[0], id[1], id[2], id[3], id[4]);
+	if (err || id[2] != 0x39 || id[3] != 0x36) {
+		return false;
+	}
+	static const uint8_t clear = 0x62, type[3] = {0x30, GT_TOUCHTYPES & 0xff, GT_TOUCHTYPES >> 8}, scan[3] = {0xa0, 0x00, 0x01};
+	(void)ftm_write(&clear, 1);
+	tt_wait(10);
+	(void)ftm_write(type, 3);
+	tt_wait(10);
+	(void)ftm_write(scan, 3);
+	tt_wait(50);
+	printf("GTS4L TOUCH: scanning, attention %u\n", tt_in(G_ATTN));
+	return true;
+}
+
+static void
+gt_event(const uint8_t *e, uint32_t *mask, int *x, int *y)
+{
+	static unsigned logged;
+	unsigned id = (e[0] >> 2) & 0xfu, action = e[0] >> 6;
+	unsigned ttype = ((e[6] >> 6) << 2) | (e[7] >> 6);
+	if (e[0] != 0 && logged < 300) {
+		logged++;
+		printf("GTS4L TOUCH: event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+	}
+	if ((e[0] & 3u) == 1u && ((e[0] >> 2) & 0xfu) == 1u && e[1] == 0x02) {
+		tt_reset_needed = true;         /* ESD */
+		return;
+	}
+	if ((e[0] & 3u) != 0 || id >= TT_MAX) {
+		return;
+	}
+	if (action == 3 || ttype == 5) {        /* release, palm */
+		*mask &= ~(1u << id);
+		return;
+	}
+	if (action == 1 || action == 2) {
+		int tx = (e[1] << 4) | (e[3] >> 4), ty = (e[2] << 4) | (e[3] & 0xf);
+		tx = (gt_flip & 1) ? 1599 - tx : tx;
+		ty = (gt_flip & 2) ? 2559 - ty : ty;
+		*mask |= 1u << id;
+		x[id] = tx - (1600 - 1125) / 2 + 157;
+		y[id] = ty - (2560 - 2436) / 2 + 222;
+	}
+}
+
+static int
+gt_poll(void)
+{
+	static const uint8_t c = GT_READ_ONE;
+	uint8_t e[8];
+	uint32_t mask = tt.active;
+	int x[TT_MAX], y[TT_MAX];
+	for (unsigned i = 0; i < TT_MAX; i++) {
+		x[i] = tt_sent_x[i];
+		y[i] = tt_sent_y[i];
+	}
+	for (unsigned n = 0; n <= TT_FIFO_MAX; n++) {
+		int err = qup_xfer(&c, 1, e, 8);
+		if (err) {
+			return err;
+		}
+		gt_event(e, &mask, x, y);
+		if ((e[7] & 0x3fu) == 0) {
+			break;
+		}
+	}
+	if (gt_mode >= 2) {
+		tt_report(mask, x, y);
+	}
+	return 0;
+}
+
+static void
+gt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 5;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("gts4lflip", &gt_flip, sizeof(gt_flip));
+	printf("GTS4L TOUCH: mode %d flip %d, starting in %u s\n", gt_mode, gt_flip, delay_s);
+	tt_wait(delay_s * 1000u);
+	tt.ahb_vote = 1u << 15;
+	tt.vote = ml_io_map(TT_GCC_VOTE_PA, 0x1000);
+	tt.ahb = ml_io_map(0x00125000u, 0x1000);
+	tt.gccqup = ml_io_map(0x00128000u, 0x1000);
+	tt.qup = ml_io_map(0x0c1b6000u, 0x1000);
+	tt.gpio[G_SDA] = ml_io_map(0x03506000u, 0x1000);
+	tt.gpio[G_SCL] = ml_io_map(0x03507000u, 0x1000);
+	tt.gpio[G_ATTN] = ml_io_map(0x03d79000u, 0x1000);
+	if (!tt.vote || !tt.ahb || !tt.gccqup || !tt.qup || !tt.gpio[G_SDA] || !tt.gpio[G_SCL] || !tt.gpio[G_ATTN]) {
+		printf("GTS4L TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	static const struct { unsigned ldo; uint32_t uv; } on[] = {{28, 3300000}, {6, 1800000}};
+	for (unsigned i = 0; i < 2; i++) {
+		for (uint32_t set = 0; set < 2; set++) {
+			if (!sweet_rpm_ldoa_set(on[i].ldo, on[i].uv, set)) {
+				printf("GTS4L TOUCH: L%u vote failed\n", on[i].ldo);
+			}
+		}
+	}
+	tt_gpio(G_ATTN, 0, 0, 2, false, false);
+	tt_gpio(G_SDA, 3, 0, 2, false, false);
+	tt_gpio(G_SCL, 3, 0, 2, false, false);
+	tt_wait(50);
+	printf("GTS4L TOUCH: powered: sda %#x/%u scl %#x/%u attn %#x/%u\n", tt_rd(tt.gpio[G_SDA], 0), tt_in(G_SDA),
+	    tt_rd(tt.gpio[G_SCL], 0), tt_in(G_SCL), tt_rd(tt.gpio[G_ATTN], 0), tt_in(G_ATTN));
+	if (!tt_clocks() || !qup_init() || !gt_init()) {
+		goto out;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / 60, &tt_move_gap);
+	unsigned errors = 0, ticks = 0;
+	for (;;) {
+		if (!tt_in(G_ATTN) || (++ticks % 20u) == 0) {
+			int err = gt_poll();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("GTS4L TOUCH: read err %d status %#x flags %#x\n", err, tt.last_status, tt.last_err);
+				}
+				(void)qup_init();
+			} else {
+				errors = 0;
+			}
+			if (tt_reset_needed) {
+				tt_reset_needed = false;
+				printf("GTS4L TOUCH: ESD event, resetting\n");
+				if (gt_mode >= 2) {
+					tt_report(0, tt.x, tt.y);
+				}
+				(void)gt_init();
+			}
+		}
+		tt_wait(10);
+	}
+out:
+	printf("GTS4L TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
