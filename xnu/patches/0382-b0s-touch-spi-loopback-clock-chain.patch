+/* SPI self-loopback: data comes back only if the SPI clock runs. */
+static bool
+b0st_loop_test(const char *tag)
+{
+	static const uint8_t t[4] = { 0xa5, 0x5a, 0x3c, 0xc3 };
+	uint8_t r[4] = { 0 };
+	b0st_loopback = 1u << 3;
+	int e = b0st_xfer(t, r, 4);
+	b0st_loopback = 0;
+	bool ok = e == 0 && memcmp(t, r, 4) == 0;
+	printf("B0S TOUCH: loopback [%s]: %d, rx %02x %02x %02x %02x -> %s\n", tag, e, r[0], r[1], r[2], r[3],
+	    ok ? "SPI clock runs" : "no SPI clock");
+	return ok;
+}
+
+static void
+b0st_clock_report(const char *tag)
+{
+	printf("B0S TOUCH: clocks [%s]: TOP mux 0x%x div 0x%x gate 0x%x, PERIC2 ip0_user 0x%x, usi06 mux 0x%x div 0x%x\n",
+	    tag, rd(cmu_top, TOP_MUX_PERIC2_IP0), rd(cmu_top, TOP_DIV_PERIC2_IP0), rd(cmu_top, TOP_GAT_PERIC2_IP0),
+	    rd(cmu, CMU_IP0_USER), rd(cmu, CMU_MUX_USI06), rd(cmu, CMU_DIV_USI06));
+}
