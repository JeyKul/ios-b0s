 static volatile uint32_t *taimen_ps_hold;       /* mapped in start(); panic context must not map */
+/*
+ * Galaxy S22 Ultra (b0s, Exynos 2200), boot-arg b0s=1: the TAIMEN kernel on a Samsung SoC.
+ * No Qualcomm block exists there (a read of the APSS WDT hung boot 2), and the kernel runs at
+ * EL1 under Samsung's EL2 (PSCI method "hvc" in the live FDT).
+ */
+static int sweet_b0s = -1;
+extern "C" int
+sweet_is_b0s(void)
+{
+	if (sweet_b0s < 0) {
+		int on = 0;
+		(void)PE_parse_boot_argn("b0s", &on, sizeof(on));
+		sweet_b0s = on != 0;
+	}
+	return sweet_b0s;
+}
+
 static int
 taimen_halt_restart(unsigned int type __unused)
 {
+	if (sweet_b0s > 0) {
+		register uint64_t x0 __asm__("x0") = 0x84000009ULL;     /* PSCI SYSTEM_RESET */
+		__asm__ volatile("dsb sy; hvc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+		for (;;) {
+			__asm__ volatile("wfi");
+		}
+	}
 	/*
 	 * Boot 15 (reset ladder): PSCI SYSTEM_RESET via smc and hvc both return
 	 * with x0 untouched under QHEE, and the APSS WDT bite no longer resets
