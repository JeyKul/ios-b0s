+/*
+ * Galaxy S22 Ultra (b0s=1, Exynos 2200 UFS, drivers/scsi/ufs/ufs-exynos*.c): the host takes
+ * 128-byte PRDT entries (FMP descriptor type 3, set through the secure monitor as Linux does;
+ * crypto fields zero = plain data) of at most 4 KiB each (HCI_TXPRDT_ENTRY_SIZE 12).
+ */
+extern int sweet_is_b0s(void);          /* iokit/Kernel/arm/SweetPlatformExpert.cpp, xnu 0370 */
+#define B0S_VS_HCI              0x1100  /* vendor HCI registers, from the UFS base */
+#define B0S_TXPRDT_ENTRY_SIZE   0x00
+#define B0S_RXPRDT_ENTRY_SIZE   0x04
+#define B0S_PRDT_STRIDE         128u
+#define B0S_PRDT_CHUNK          4096u
+
+static uint64_t
+b0s_smc(uint64_t cmd, uint64_t a0, uint64_t a1, uint64_t a2)
+{
+	register uint64_t x0 __asm__("x0") = cmd;
+	register uint64_t x1 __asm__("x1") = a0;
+	register uint64_t x2 __asm__("x2") = a1;
+	register uint64_t x3 __asm__("x3") = a2;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+	    "x16", "x17", "memory");
+	return x0;
+}
+
+static void
+b0s_ufs_setup(void)
+{
+	/* exynos-smc.h: SMC_CMD_SMU(SMU_INIT, FMP_EMBEDDED), SMC_CMD_FMP_SECURITY(0, FMP_EMBEDDED, DESCTYPE_3) */
+	uint64_t r1 = b0s_smc(0x82001850ULL, 0, 0, 0);
+	uint64_t r2 = b0s_smc(0x8C2001810ULL, 0, 0, 3);
+	uint32_t tx = ufs_rd(B0S_VS_HCI + B0S_TXPRDT_ENTRY_SIZE), rx = ufs_rd(B0S_VS_HCI + B0S_RXPRDT_ENTRY_SIZE);
+	ufs_wr(B0S_VS_HCI + B0S_TXPRDT_ENTRY_SIZE, (1u << 31) | 12);   /* PRDT_PREFECT_EN | PRDT_SET_SIZE(12) */
+	ufs_wr(B0S_VS_HCI + B0S_RXPRDT_ENTRY_SIZE, 12);
+	printf("SWEET UFS: b0s: SMU init %llu, FMP desctype 3 %llu, PRDT size tx 0x%x rx 0x%x (were 0x%x 0x%x), cap 0x%x\n",
+	    r1, r2, ufs_rd(B0S_VS_HCI + B0S_TXPRDT_ENTRY_SIZE), ufs_rd(B0S_VS_HCI + B0S_RXPRDT_ENTRY_SIZE),
+	    tx, rx, ufs_rd(REG_CAP));
+}
