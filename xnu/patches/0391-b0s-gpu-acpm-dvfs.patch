@@ -33,6 +33,19 @@
 #define G3D_SYSREG      0x16c00000UL
 #define GPU_RMMIO       0x16e00000UL
 
+/*
+ * ACPM IPC (acpm/acpm_ipc.c, fw_header/framework.h), DT acpm_ipc: mailbox 0x15900000, APM SRAM 0x02060000
+ * (0x50000), struct acpm_framework at SRAM + 0xf800. DVFS: DT acpm_dvfs acpm-ipc-channel 5; cal-if/acpm_dvfs.c
+ * exynos_acpm_set_rate cmd = { id | seq << 16, rate kHz, FREQ_REQ 0, 0 }; G3D id = 0xb04000d & 0xffff = 13.
+ */
+#define ACPM_MBOX       0x15900000UL
+#define ACPM_INTGR0     0x008
+#define ACPM_SRAM       0x02060000UL
+#define ACPM_INITDATA   0xf800
+#define ACPM_CH_DVFS    5
+#define DVFS_ID_G3D     13
+#define G3D_RATE_KHZ    302000          /* DT sgpu min_freq 0x49f98 */
+
 #define PWRCTL_CTL2     0x4
 #define PWRCTL_STATUS   0x8
 
