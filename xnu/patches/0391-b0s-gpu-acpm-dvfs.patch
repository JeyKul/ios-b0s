 	return false;
 }
 
+/* struct ipc_channel: id, field, owner, type, channel_info (13 x u32), ap_poll = 72 bytes */
+#define IPC_CH_SIZE     72
+#define CH_INFO         16
+enum { RX_REAR = 0, RX_FRONT = 4, RX_BASE = 8, TX_REAR = 24, TX_FRONT = 28, TX_BASE = 32, Q_LEN = 36, Q_ELEM = 40 };
+
+/* One request on channel ch, polled reply: the AP sends on the channel's rx_* queue, APM answers on tx_*. */
+static int
+acpm_send(unsigned ch, uint32_t c0, uint32_t c1, uint32_t c2, uint32_t c3, uint32_t reply[4])
+{
+	uint32_t chans = rd(sram, ACPM_INITDATA + 8), ap_max = rd(sram, ACPM_INITDATA + 24);
+	if (ch >= ap_max || chans >= 0x50000) {
+		printf("B0S GPU: ACPM initdata odd: ipc_channels 0x%x ipc_ap_max %u\n", chans, ap_max);
+		return EINVAL;
+	}
+	uint32_t c = chans + ch * IPC_CH_SIZE, ci = c + CH_INFO;
+	uint32_t id = rd(sram, c), len = rd(sram, ci + Q_LEN), size = rd(sram, ci + Q_ELEM);
+	uint32_t txb = rd(sram, ci + RX_BASE), rxb = rd(sram, ci + TX_BASE);
+	printf("B0S GPU: ACPM ch %u: id %u q_len %u elem %u poll %u, tx base 0x%x f/r %u/%u, rx base 0x%x f/r %u/%u\n",
+	    ch, id, len, size, rd(sram, ci + 52), txb, rd(sram, ci + RX_FRONT), rd(sram, ci + RX_REAR),
+	    rxb, rd(sram, ci + TX_FRONT), rd(sram, ci + TX_REAR));
+	if (id != ch || len == 0 || len > 64 || size < 16 || size > 64 || txb >= 0x50000 || rxb >= 0x50000) {
+		return EINVAL;
+	}
+	uint32_t front = rd(sram, ci + RX_FRONT), next = (front + 1) % len;
+	if (next == rd(sram, ci + RX_REAR)) {
+		printf("B0S GPU: ACPM ch %u queue full\n", ch);
+		return EBUSY;
+	}
+	uint32_t seq = 1;
+	uint32_t cmd[4] = { (c0 & ~(0x3fu << 16)) | (seq << 16), c1, c2, c3 };
+	for (uint32_t o = 0; o < size; o += 4) {
+		wr(sram, txb + size * front + o, o < 16 ? cmd[o / 4] : 0);
+	}
+	wr(sram, ci + RX_FRONT, next);
+	wr(mbox, ACPM_INTGR0, (1u << ch) << 16);
+	for (int t = 0; t < 100000; t++) {
+		uint32_t r = rd(sram, ci + TX_REAR), f = rd(sram, ci + TX_FRONT);
+		if (r != f) {
+			for (int k = 0; k < 4; k++) {
+				reply[k] = rd(sram, rxb + size * r + 4 * k);
+			}
+			wr(sram, ci + TX_REAR, (r + 1) % len);
+			return 0;
+		}
+		delay(1);
+	}
+	printf("B0S GPU: ACPM ch %u: no reply in 100 ms\n", ch);
+	return ETIMEDOUT;
+}
