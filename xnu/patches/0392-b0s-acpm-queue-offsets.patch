+/*
+ * One request on channel ch, polled reply: the AP sends on the channel's rx_* queue, APM answers on tx_*.
+ * channel_info's rear/front/base are SRAM *offsets* (acpm_ipc.c: ch.rear = base + readl(&info.q_rear)), not
+ * values: boot 27 printed rx f/r 62220/62216 = 0xf30c/0xf308, right before rx base 0xf310. 0391 used them as
+ * indices and wrote ~1 MiB past the 0x50000 SRAM mapping (the freeze after "ACPM ch 5"). Queue indices are
+ * the words at those offsets.
+ */
+static inline bool
+sram_ok(uint32_t off, uint32_t len)
+{
+	return off < 0x50000 && len <= 0x50000 - off;
+}
