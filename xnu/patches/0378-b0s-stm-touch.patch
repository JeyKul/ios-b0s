+/*
+ * Galaxy S22 Ultra (b0s, Exynos 2200) touch: STM FTS (fts2ba61y) on SPI2, polled.
+ *
+ * Every value is from the phone's live FDT or Samsung's kernel source
+ * (ExtremeXT/android_kernel_samsung_s5e9925):
+ *   SPI2      spi@11D40000 "samsung,exynos-spi", USI mode via sysreg_peric2_2_usi (0x11c22000) + 0x10,
+ *             FIFO 256 (level mask 0x1ff, RX level at bit 15, TX done bit 25), clock from CMU
+ *   clock     DOUT_DIV_CLK_PERIC2_USI06 (cmucal): mux 0x11c01028, div 0x11c01828, gates 0x11c0208c,
+ *             0x11c020fc (IPCLK), 0x11c02100 (PCLK). Mux 0 = OSCCLK: the SPI runs at OSC/4 (~6.4 MHz,
+ *             under the DT's 10 MHz).
+ *   pins      spi_bus gpp2-0..2 function 2; CS gpp2-3 as a GPIO (cs-gpio, the STM driver drives it);
+ *             IRQ gpa1-2 (active low), read as level. GPIO_PERIC2 0x11c30000 (gpp2 at +0x40),
+ *             GPIO_ALIVE 0x15850000 (gpa1 at +0x20).
+ *   rails     tsp_io = vdd_ldo28 (main PMIC, 1.8 V), tsp_avdd = vdd_ldo17s (sub PMIC, 3.0 V), DT
+ *             min = max voltages; written through the ACPM SPMI mailbox (0x15900000, channel 8) as
+ *             uniLoader's g0s board does, and only if the rail is off.
+ *   protocol  stm_core.c: write = [0xC0] reg data (raw for A0/A2/A4/A7/FA/FB); read of 0x87 = 87 then
+ *             data at +2; other reads = write C0 reg, then D1 00 00, data at +4. Events 16 bytes.
+ *
+ * Boot-arg b0stouch: 0 off, 1 probe and report only, 2 (default) touch events to SweetHID.
+ */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_is_b0s(void);          /* SweetPlatformExpert.cpp, xnu 0370 */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+void b0s_touch_init(void);
+
+#define ACPM_MBOX       0x15900000UL
+#define ACPM_INTGR0     0x008
+#define ACPM_INTCR1     0x020
+#define ACPM_INTSR1     0x028
+#define ACPM_SR0        0x100
+#define ACPM_SR1        0x104
+#define ACPM_SR2        0x108
+#define ACPM_SR3        0x10c
+#define ACPM_CH_SPMI    8
+
+#define CMU_PERIC2      0x11c00000UL
+#define CMU_MUX_USI06   0x1028
+#define CMU_DIV_USI06   0x1828
+#define CMU_GAT_RSTN    0x208c
+#define CMU_GAT_IPCLK   0x20fc
+#define CMU_GAT_PCLK    0x2100
+#define GAT_MANUAL      (1u << 20)
+#define GAT_CG_VAL      (1u << 21)
+
+#define SYSREG_USI      0x11c22000UL
+#define SYSREG_USI_OFF  0x10
+#define USI_SPI_SW_CONF (1u << 1)
+
+#define GPIO_PERIC2     0x11c30000UL
+#define GPP2            0x40            /* CON +0, DAT +4, PUD +8 */
+#define GPIO_ALIVE      0x15850000UL
+#define GPA1            0x20
+
+#define SPI2            0x11d40000UL
+#define SPI_CH_CFG      0x00
+#define SPI_MODE_CFG    0x08
+#define SPI_SLAVE_SEL   0x0c
+#define SPI_INT_EN      0x10
+#define SPI_STATUS      0x14
+#define SPI_TX_DATA     0x18
+#define SPI_RX_DATA     0x1c
+#define SPI_PACKET_CNT  0x20
+#define SPI_PENDING_CLR 0x24
+#define SPI_SWAP_CFG    0x28
+#define USI_CON         0xc4
+#define USI_OPTION      0xc8
+#define CH_SW_RST       (1u << 5)
+#define CH_RXCH_ON      (1u << 1)
+#define CH_TXCH_ON      (1u << 0)
+#define TRAILCNT        (0x3ffu << 19)
+#define PACKET_CNT_EN   (1u << 16)
+#define ST_RX_LVL(v)    (((v) >> 15) & 0x1ff)
+#define ST_TX_LVL(v)    (((v) >> 6) & 0x1ff)
+#define ST_TX_DONE      (1u << 25)
+
+#define PANEL_W         1440
+#define PANEL_H         3088
+#define CANVAS_H        3084            /* shim B0S_GUI_H */
+#define FINGERS         10
+
+static vm_offset_t mbox, cmu, sysreg, gpio_p2, gpio_al, spi;
+static int b0st_mode = 2;
+static int b0st_sleep_chan;
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; __builtin_arm_dsb(0xf); }
+
+static void
+b0st_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&b0st_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- ACPM SPMI (uniLoader drivers/samsung/exynos-acpm.c) ---- */
+
+static int
+acpm_spmi(uint32_t func, uint32_t sid, uint32_t type, uint32_t reg, uint32_t val, uint8_t *out)
+{
+	uint32_t c0 = (type & 0xff) << 8 | (reg & 0xff);
+	uint32_t c1 = (func & 0xff) | (val & 0xff) << 8 | (sid & 0xf) << 24;
+	wr(mbox, ACPM_SR0, c0);
+	wr(mbox, ACPM_SR1, c1);
+	wr(mbox, ACPM_INTGR0, (1u << ACPM_CH_SPMI) << 16);
+	for (int i = 0; !(rd(mbox, ACPM_INTSR1) & (1u << ACPM_CH_SPMI)); i++) {
+		if (i > 100000) {
+			printf("B0S TOUCH: ACPM SPMI timeout (func %u sid %u reg 0x%x)\n", func, sid, reg);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	wr(mbox, ACPM_INTCR1, 1u << ACPM_CH_SPMI);
+	(void)rd(mbox, ACPM_SR2);
+	uint32_t r = rd(mbox, ACPM_SR3);
+	if (out) {
+		*out = (uint8_t)(r >> 8);
+	}
+	return (int)((r >> 24) & 0xff);
+}
+
+/* Enable an LDO at its DT voltage if it is off. ctrl = enable (0xc0) | voltage code. */
+static void
+b0st_rail(const char *name, uint32_t sid, uint32_t reg, uint8_t want)
+{
+	uint8_t v = 0;
+	int r = acpm_spmi(0 /* read */, sid, 5, reg, 0, &v);
+	printf("B0S TOUCH: %s ctrl 0x%02x (ret %d)\n", name, v, r);
+	if (r != 0 || (v & 0xc0)) {
+		return;
+	}
+	r = acpm_spmi(1 /* write */, sid, 5, reg, want, NULL);
+	(void)acpm_spmi(0, sid, 5, reg, 0, &v);
+	printf("B0S TOUCH: %s on: wrote 0x%02x, reads 0x%02x (ret %d)\n", name, want, v, r);
+}
+
+/* ---- SPI2 (spi-s3c64xx.c, polled, CS by GPIO) ---- */
+
+static void
+b0st_cs(bool active)
+{
+	uint32_t d = rd(gpio_p2, GPP2 + 4);
+	wr(gpio_p2, GPP2 + 4, active ? (d & ~(1u << 3)) : (d | (1u << 3)));
+}
+
+static int
+b0st_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (len == 0 || len > 128) {
+		return EINVAL;
+	}
+	uint32_t ch = rd(spi, SPI_CH_CFG) & ~(CH_TXCH_ON | CH_RXCH_ON);
+	wr(spi, SPI_CH_CFG, ch | CH_SW_RST);
+	wr(spi, SPI_CH_CFG, ch & ~CH_SW_RST);
+	wr(spi, SPI_MODE_CFG, TRAILCNT);                /* byte channel and bus size, no DMA */
+	wr(spi, SPI_PACKET_CNT, len | PACKET_CNT_EN);
+	b0st_cs(true);
+	for (unsigned i = 0; i < len; i++) {
+		*(volatile uint8_t *)(spi + SPI_TX_DATA) = tx ? tx[i] : 0;
+	}
+	wr(spi, SPI_CH_CFG, (ch & ~CH_SW_RST) | CH_TXCH_ON | CH_RXCH_ON);
+	unsigned got = 0;
+	for (int spins = 0; got < len; spins++) {
+		uint32_t st = rd(spi, SPI_STATUS);
+		for (unsigned n = ST_RX_LVL(st); n > 0 && got < len; n--, got++) {
+			uint8_t b = *(volatile uint8_t *)(spi + SPI_RX_DATA);
+			if (rx) {
+				rx[got] = b;
+			}
+		}
+		if (spins > 20000) {
+			b0st_cs(false);
+			wr(spi, SPI_CH_CFG, ch);
+			printf("B0S TOUCH: SPI timeout: %u/%u bytes, status 0x%x\n", got, len, st);
+			return ETIMEDOUT;
+		}
+		if (got < len) {
+			delay(1);
+		}
+	}
+	for (int spins = 0; !(rd(spi, SPI_STATUS) & ST_TX_DONE) && spins < 1000; spins++) {
+		delay(1);
+	}
+	delay(10);                              /* t->delay_usecs = 10 */
+	b0st_cs(false);
+	wr(spi, SPI_CH_CFG, ch);
+	wr(spi, SPI_PACKET_CNT, 0);
+	return 0;
+}
+
+static int
+stm_write(const uint8_t *buf, unsigned len)
+{
+	uint8_t t[32];
+	unsigned n = 0;
+	if (len + 1 > sizeof(t)) {
+		return EINVAL;
+	}
+	switch (buf[0]) {
+	case 0xa0: case 0xa2: case 0xa4: case 0xa7: case 0xfa: case 0xfb:
+		break;
+	default:
+		t[n++] = 0xc0;
+	}
+	memcpy(t + n, buf, len);
+	return b0st_xfer(t, NULL, n + len);
+}
+
+/* Read rlen bytes for register reg (one byte; 0x87 is the event FIFO). */
+static int
+stm_read(uint8_t reg, uint8_t *out, unsigned rlen)
+{
+	uint8_t t[64], r[64];
+	unsigned hdr;
+	int e;
+	if (rlen + 4 > sizeof(t)) {
+		return EINVAL;
+	}
+	bzero(t, sizeof(t));
+	if (reg == 0x87) {
+		t[0] = reg;
+		hdr = 1;
+	} else {
+		if ((e = stm_write(&reg, 1)) != 0) {
+			return e;
+		}
+		t[0] = 0xd1;
+		hdr = 3;
+	}
+	if ((e = b0st_xfer(t, r, rlen + 1 + hdr)) != 0) {
+		return e;
+	}
+	memcpy(out, r + 1 + hdr, rlen);
+	return 0;
+}
+
+static bool
+b0st_irq_low(void)
+{
+	return !(rd(gpio_al, GPA1 + 4) & (1u << 2));
+}
+
+static void
+b0st_hw_setup(void)
+{
+	/* clock: OSCCLK, divider 1, gates forced on */
+	printf("B0S TOUCH: CMU mux 0x%x div 0x%x gates 0x%x 0x%x 0x%x\n", rd(cmu, CMU_MUX_USI06),
+	    rd(cmu, CMU_DIV_USI06), rd(cmu, CMU_GAT_RSTN), rd(cmu, CMU_GAT_IPCLK), rd(cmu, CMU_GAT_PCLK));
+	wr(cmu, CMU_MUX_USI06, rd(cmu, CMU_MUX_USI06) & ~0x3u);
+	wr(cmu, CMU_DIV_USI06, rd(cmu, CMU_DIV_USI06) & ~0x7fu);
+	wr(cmu, CMU_GAT_RSTN, rd(cmu, CMU_GAT_RSTN) | GAT_MANUAL | GAT_CG_VAL);
+	wr(cmu, CMU_GAT_IPCLK, rd(cmu, CMU_GAT_IPCLK) | GAT_MANUAL | GAT_CG_VAL);
+	wr(cmu, CMU_GAT_PCLK, rd(cmu, CMU_GAT_PCLK) | GAT_MANUAL | GAT_CG_VAL);
+	/* USI in SPI mode */
+	wr(sysreg, SYSREG_USI_OFF, (rd(sysreg, SYSREG_USI_OFF) & ~0x7u) | USI_SPI_SW_CONF);
+	/* pins: gpp2-0..2 SPI (function 2), gpp2-3 output high (CS idle), no pulls */
+	uint32_t con = rd(gpio_p2, GPP2);
+	con = (con & ~0xffffu) | 0x1222u;
+	b0st_cs(false);
+	wr(gpio_p2, GPP2, con);
+	wr(gpio_p2, GPP2 + 8, rd(gpio_p2, GPP2 + 8) & ~0xffffu);
+	/* controller: USI out of reset, nCS control, then s3c64xx_spi_hwinit */
+	wr(spi, USI_CON, 0);
+	wr(spi, USI_OPTION, rd(spi, USI_OPTION) | (1u << 5));
+	wr(spi, SPI_SLAVE_SEL, 1);              /* SIG_INACT: CS is the GPIO */
+	wr(spi, SPI_INT_EN, 0);
+	wr(spi, SPI_MODE_CFG, 0);
+	wr(spi, SPI_PACKET_CNT, 0);
+	wr(spi, SPI_PENDING_CLR, 0x1f);
+	wr(spi, SPI_PENDING_CLR, 0);
+	wr(spi, SPI_SWAP_CFG, 0);
+	wr(spi, SPI_CH_CFG, 0);                 /* master, mode 0 */
+	printf("B0S TOUCH: USI sysreg 0x%x, gpp2 con 0x%x, spi status 0x%x, irq %s\n",
+	    rd(sysreg, SYSREG_USI_OFF), rd(gpio_p2, GPP2), rd(spi, SPI_STATUS), b0st_irq_low() ? "low" : "high");
+}
+
+static int
+b0st_read_event(uint8_t ev[16])
+{
+	return stm_read(0x87, ev, 16);
+}
+
+static bool
+b0st_ready(unsigned ms)
+{
+	uint8_t ev[16];
+	for (unsigned t = 0; t < ms; t += 10) {
+		if (b0st_read_event(ev) == 0 && ev[0] == 0x03) {
+			return true;
+		}
+		b0st_wait(10);
+	}
+	return false;
+}
+
+static void
+b0st_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	uint8_t id[5] = { 0 }, ev[16];
+	static const uint8_t reset[6] = { 0xfa, 0x20, 0x00, 0x00, 0x24, 0x81 };
+	static const uint8_t sense_on[1] = { 0x10 };
+	static const uint8_t scan[3] = { 0xa0, 0x00, 0x01 };
+	bool down[FINGERS] = { 0 };
+
+	b0st_rail("tsp_io ldo28m", 0, 0xd4, 0xc0 | 24);         /* 1.8 V: 1.5 V + 24 * 12.5 mV */
+	b0st_rail("tsp_avdd ldo17s", 1, 0xec, 0xc0 | 48);       /* 3.0 V: 1.8 V + 48 * 25 mV */
+	b0st_wait(50);
+	b0st_hw_setup();
+
+	int e = stm_write(reset, sizeof(reset));
+	b0st_wait(30);
+	bool ready = b0st_ready(500);
+	int e2 = stm_read(0x22, id, sizeof(id));
+	printf("B0S TOUCH: reset %d, ready %d, id %d: %02x %02x %02x %02x %02x\n", e, ready, e2,
+	    id[0], id[1], id[2], id[3], id[4]);
+	if (e || e2 || b0st_mode < 2) {
+		return;
+	}
+	(void)stm_write(sense_on, sizeof(sense_on));
+	b0st_wait(5);
+	(void)stm_write(scan, sizeof(scan));
+	printf("B0S TOUCH: sensing\n");
+
+	for (unsigned errs = 0;;) {
+		if (!b0st_irq_low()) {
+			b0st_wait(8);
+			continue;
+		}
+		for (int guard = 0; guard < 32 && b0st_irq_low(); guard++) {
+			if (b0st_read_event(ev) != 0) {
+				if (++errs > 50) {
+					printf("B0S TOUCH: too many SPI errors, stopping\n");
+					return;
+				}
+				break;
+			}
+			if ((ev[0] & 0x3) != 0) {       /* not a coordinate event */
+				if (ev[0] != 0 && ev[0] != 0xff) {
+					printf("B0S TOUCH: event %02x %02x %02x %02x\n", ev[0], ev[1], ev[2], ev[3]);
+				}
+				continue;
+			}
+			int tid = (ev[0] >> 2) & 0xf, sta = ev[0] >> 6;
+			int x = ev[1] << 4 | ev[3] >> 4, y = ev[2] << 4 | (ev[3] & 0xf);
+			if (tid >= FINGERS || sta == 0) {
+				continue;
+			}
+			int px = x * PANEL_W / 4096, py = y * PANEL_H / 4096;
+			if (py > CANVAS_H - 1) {
+				py = CANVAS_H - 1;
+			}
+			bool d = sta != 3;
+			if (d || down[tid]) {
+				sweet_hid_touch(tid, d, px, py);
+			}
+			down[tid] = d;
+		}
+	}
+}
+
+void
+b0s_touch_init(void)
+{
+	thread_t th;
+	if (!sweet_is_b0s()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("b0stouch", &b0st_mode, sizeof(b0st_mode));
+	if (b0st_mode <= 0) {
+		printf("B0S TOUCH: off (b0stouch=0)\n");
+		return;
+	}
+	mbox = ml_io_map(ACPM_MBOX, 0x1000);
+	cmu = ml_io_map(CMU_PERIC2, 0x3000);
+	sysreg = ml_io_map(SYSREG_USI, 0x1000);
+	gpio_p2 = ml_io_map(GPIO_PERIC2, 0x1000);
+	gpio_al = ml_io_map(GPIO_ALIVE, 0x1000);
+	spi = ml_io_map(SPI2, 0x1000);
+	if (!mbox || !cmu || !sysreg || !gpio_p2 || !gpio_al || !spi) {
+		printf("B0S TOUCH: mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(b0st_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
